{
  "name": "@yunfanye/sql-proxy",
  "version": "1.1.0",
  "description": "A SQL proxy server that accepts SQL queries via HTTP and executes them against configured database backends (PostgreSQL, MySQL, Snowflake)",
  "main": "dist/index.js",
  "bin": {
    "sql-proxy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sql",
    "proxy",
    "database",
    "postgresql",
    "mysql",
    "snowflake",
    "http",
    "api"
  ],
  "author": "yunfanye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunfanye/sql-proxy.git"
  },
  "homepage": "https://github.com/yunfanye/sql-proxy#readme",
  "bugs": {
    "url": "https://github.com/yunfanye/sql-proxy/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "cloudflared": "^0.5.3",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "inquirer": "^8.2.6",
    "mysql2": "^3.6.5",
    "node-sql-parser": "^4.18.0",
    "pg": "^8.11.3",
    "snowflake-sdk": "^1.9.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
